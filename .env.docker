# ===========================================
# TaxCat Docker Environment Configuration
# For Unraid Server Deployment
# ===========================================

# ===========================================
# APPLICATION ENVIRONMENT
# ===========================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
TZ=America/Toronto

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL Connection
# IMPORTANT: Update these with your actual PostgreSQL credentials
POSTGRES_USER=taxcat
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_123
POSTGRES_DB=taxcat

# Full Database URL (automatically constructed in docker-compose.yml)
# If using external PostgreSQL container, update the host
DATABASE_URL=postgresql://taxcat:CHANGE_THIS_PASSWORD_123@postgres:5432/taxcat?schema=public&sslmode=prefer

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis Password (set this if your Redis requires auth)
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Redis URL (points to your existing Redis container)
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379

# ===========================================
# APPLICATION URLS
# ===========================================

# TaxCat URLs - Update with your domain
NEXT_PUBLIC_APP_URL=https://taxcat.ca
NEXTAUTH_URL=https://taxcat.ca

# EKBooks URLs - Update with your domain
EKBOOKS_URL=https://ekbooks.ca

# ===========================================
# SECURITY & AUTHENTICATION
# ===========================================

# IMPORTANT: Generate new secrets for production!
# Generate with: openssl rand -base64 32

NEXTAUTH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32
ENCRYPTION_KEY=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ===========================================
# ADMIN CONFIGURATION
# ===========================================

# TaxCat Admin User
CMS_ADMIN_EMAIL=admin@taxcat.ca
CMS_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================

# SMTP Settings - Configure with your email provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@taxcat.ca
BUSINESS_EMAIL=admin@taxcat.ca
NOTIFICATION_EMAIL=notifications@taxcat.ca

# ===========================================
# PAYMENT PROCESSING (Optional)
# ===========================================

# Stripe Configuration - Add when ready to accept payments
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================

MAX_FILE_SIZE=10485760
UPLOAD_DIRECTORY=/app/uploads

# ===========================================
# RATE LIMITING
# ===========================================

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

LOG_LEVEL=info
LOG_FILE_PATH=/app/logs

# ===========================================
# MONITORING & ANALYTICS (Optional)
# ===========================================

# Sentry Error Tracking
SENTRY_DSN=

# Google Analytics
NEXT_PUBLIC_GA_ID=

# ===========================================
# AUTHENTIK INTEGRATION (Optional)
# ===========================================

# If you want to use your existing Authentik for SSO
# Uncomment and configure these:

# AUTHENTIK_URL=https://authentik.yourdomain.com
# AUTHENTIK_CLIENT_ID=your-client-id
# AUTHENTIK_CLIENT_SECRET=your-client-secret
# AUTHENTIK_ISSUER=${AUTHENTIK_URL}/application/o/taxcat/

# ===========================================
# CLOUDFLARE TUNNEL (If using)
# ===========================================

# Your Cloudflare Tunnel is already configured via Traefik
# No additional configuration needed here

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Backup settings (for automated backups)
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===========================================
# NOTES FOR UNRAID DEPLOYMENT
# ===========================================

# 1. Update all CHANGE_THIS_* values before deploying
# 2. Generate new secrets with: openssl rand -base64 32
# 3. If using existing PostgreSQL/Redis containers, update connection strings
# 4. Make sure Traefik networks (webstack_net, makprox) exist
# 5. Verify domain DNS points to your Unraid server (via Cloudflare Tunnel)
# 6. After first deploy, run: docker exec taxcat npx prisma db push
