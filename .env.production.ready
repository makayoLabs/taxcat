# TaxCat Production Environment - makayoHub Unraid Server
# Generated: 2024-11-06

# ============================================
# CORE APPLICATION
# ============================================
NODE_ENV=production
TZ=America/Toronto

# ============================================
# DATABASE CONNECTION
# ============================================
# PostgreSQL 17 - Container: postgresql17
DATABASE_URL=postgresql://taxcat:2YjqAedt785BNGLhbnkK@postgresql17:5432/taxcat?schema=public

# ============================================
# REDIS CACHE
# ============================================
# Redis - Container: redis
REDIS_URL=redis://redis:6379

# ============================================
# APPLICATION URLS
# ============================================
NEXT_PUBLIC_APP_URL=https://taxcat.ca
NEXTAUTH_URL=https://taxcat.ca

# ============================================
# SECURITY SECRETS (GENERATE NEW ONES!)
# ============================================
# Run these commands to generate:
# openssl rand -base64 32
# openssl rand -base64 32
# openssl rand -hex 32

NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_SECRET_1
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_2
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET_3

# ============================================
# NEXTJS CONFIGURATION
# ============================================
NEXT_TELEMETRY_DISABLED=1

# ============================================
# OPTIONAL: STRIPE PAYMENTS
# ============================================
# Uncomment and add your keys when ready
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================
# Uncomment and configure when ready
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@taxcat.ca

# ============================================
# OPTIONAL: MONITORING & LOGGING
# ============================================
# LOG_LEVEL=info
# SENTRY_DSN=
