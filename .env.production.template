# TaxCat Production Environment Configuration
# Copy this file to .env.production and update all values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://taxcat:YOUR_DB_PASSWORD@192.168.2.125:5432/taxcat_prod

# ==========================================
# REDIS CONFIGURATION
# ==========================================
# Redis connection string
# Format: redis://:password@host:port
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@192.168.2.125:6379

# ==========================================
# NEXTAUTH CONFIGURATION
# ==========================================
# Your domain name (without https://)
NEXTAUTH_URL=https://YOUR_DOMAIN.com
# Generate a 32-character random secret
NEXTAUTH_SECRET=YOUR_32_CHARACTER_SECRET_HERE

# ==========================================
# JWT CONFIGURATION
# ==========================================
# JWT signing secret (32 characters)
JWT_SECRET=YOUR_JWT_SECRET_32_CHARS

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.com
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.com

# ==========================================
# CMS CONFIGURATION
# ==========================================
CMS_ADMIN_EMAIL=admin@YOUR_DOMAIN.com
CMS_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# 32-character encryption key for data encryption
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_32_CHARS
RATE_LIMIT_MAX=100

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIRECTORY=/app/uploads

# ==========================================
# AUTHENTIK CONFIGURATION (Optional)
# ==========================================
# If using Authentik for authentication
AUTHENTIK_URL=https://YOUR_DOMAIN.com/auth
AUTHENTIK_CLIENT_ID=taxcat-client
AUTHENTIK_CLIENT_SECRET=YOUR_AUTHENTIK_CLIENT_SECRET

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD

# ==========================================
# PAYMENT CONFIGURATION (Optional)
# ==========================================
# Stripe payment processing
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ==========================================
# MONITORING CONFIGURATION (Optional)
# ==========================================
# Sentry error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# NEXT.JS CONFIGURATION
# ==========================================
NEXT_TELEMETRY_DISABLED=1

# ==========================================
# HOW TO GENERATE SECRETS
# ==========================================
# Run these commands to generate secure secrets:
#
# NEXTAUTH_SECRET: openssl rand -base64 32
# JWT_SECRET: openssl rand -base64 32
# ENCRYPTION_KEY: openssl rand -base64 32
#
# Example output: "abc123def456ghi789jkl012mno345pqr678stu901vwx"
#
# ==========================================
# IMPORTANT NOTES
# ==========================================
# 1. Replace all YOUR_* placeholders with actual values
# 2. Database and Redis passwords must match your Unraid setup
# 3. Domain should be your actual domain (e.g., ekbooks.ca)
# 4. Keep this file secure and never commit to version control
# 5. Test all configurations before going live