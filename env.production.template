# TaxCat + EKBooks Environment Configuration Template
# Copy this file to .env.production and update with your actual values

# ===========================================
# CORE APPLICATION CONFIGURATION
# ===========================================

# Application Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# TaxCat Database (update with your actual database details)
# Format: postgresql://username:password@server:port/database_name
# Example: postgresql://taxcat:mypassword123@192.168.2.125:5432/taxcat_prod
DATABASE_URL=postgresql://taxcat:YOUR_DB_PASSWORD@192.168.2.125:5432/taxcat_prod

# EKBooks Database (if using separate database)
# Same format as above, but with different username/password
EKBOOKS_DATABASE_URL=postgresql://ekbooks:YOUR_EKBOOKS_DB_PASSWORD@192.168.2.125:5432/ekbooks_prod

# Redis Configuration (update with your Redis password)
# Redis is used for caching and storing temporary data
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@192.168.2.125:6379

# ===========================================
# APPLICATION URLs
# ===========================================

# TaxCat URLs (update with your actual domain)
# Replace "yourdomain.com" with your real website address
NEXT_PUBLIC_APP_URL=https://taxcat.YOUR_DOMAIN.com
NEXTAUTH_URL=https://taxcat.YOUR_DOMAIN.com

# EKBooks URLs (update with your actual domain)
# Replace "yourdomain.com" with your real website address
EKBOOKS_URL=https://ekbooks.YOUR_DOMAIN.com
EKBOOKS_NEXTAUTH_URL=https://ekbooks.YOUR_DOMAIN.com

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Authentication Secrets (generate new ones using: openssl rand -base64 32)
# These are like passwords for your application - keep them secret!
# You can generate new ones at: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE
JWT_SECRET=YOUR_JWT_SECRET_HERE
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# ===========================================
# ADMIN CONFIGURATION
# ===========================================

# TaxCat Admin (update with your admin credentials)
# This is the email and password for the main admin account
CMS_ADMIN_EMAIL=admin@taxcat.YOUR_DOMAIN.com
CMS_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD

# EKBooks Admin (update with your admin credentials)
# This is the email and password for the EKBooks admin account
EKBOOKS_ADMIN_EMAIL=admin@ekbooks.YOUR_DOMAIN.com
EKBOOKS_ADMIN_PASSWORD=YOUR_SECURE_EKBOOKS_PASSWORD

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP Settings (configure with your email provider)
# SMTP is how your application sends emails to users
# Common providers: Gmail, Outlook, or your hosting provider
SMTP_HOST=smtp.YOUR_DOMAIN.com
SMTP_PORT=587
SMTP_USER=admin@YOUR_DOMAIN.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
BUSINESS_EMAIL=admin@YOUR_DOMAIN.com
NOTIFICATION_EMAIL=notifications@YOUR_DOMAIN.com

# ===========================================
# CRA INTEGRATION CONFIGURATION
# ===========================================

# CRA E-Services Configuration (for tax filing)
# You need these to submit tax returns electronically to the government
CRA_ENVIRONMENT=TEST
CRA_ESERVICES_NUMBER=your_cra_eservices_number
CRA_PASSWORD=your_cra_password

# CRA API Configuration (when you get API access)
# These are for advanced features - you'll get these later
CRA_CLIENT_ID=your_cra_client_id
CRA_CLIENT_SECRET=your_cra_client_secret

# ===========================================
# PAYMENT PROCESSING (Optional)
# ===========================================

# Stripe Configuration (if using Stripe for payments)
# Stripe is a payment processor that handles credit card payments
# Get these from your Stripe dashboard at https://stripe.com
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ===========================================
# MONITORING & ANALYTICS (Optional)
# ===========================================

# Sentry Error Tracking (if using Sentry)
# Sentry helps you find and fix bugs in your application
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID

# Google Analytics (if using Google Analytics)
# Google Analytics shows you how many people visit your website
NEXT_PUBLIC_GA_ID=G-YOUR_GA_ID

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================

# Maximum file size (in bytes) - 10MB default
# This controls how big files users can upload
MAX_FILE_SIZE=10485760
UPLOAD_DIRECTORY=/app/uploads

# ===========================================
# RATE LIMITING
# ===========================================

# Rate limiting configuration
# This prevents people from making too many requests to your server
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

# Logging settings
# This controls how much information gets saved to log files
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs

# ===========================================
# NEXTCLOUD INTEGRATION (Optional)
# ===========================================

# Nextcloud AIO Integration (if using Nextcloud)
# Nextcloud is a file storage and sharing system
NEXTCLOUD_MAIL_PASSWORD=YOUR_NEXTCLOUD_MAIL_PASSWORD

# ===========================================
# AUTHENTIK INTEGRATION (Optional)
# ===========================================

# Authentik Integration (if using Authentik for authentication)
# Authentik is a user management system
AUTHENTIK_URL=https://authentik.YOUR_DOMAIN.com
AUTHENTIK_CLIENT_ID=YOUR_AUTHENTIK_CLIENT_ID
AUTHENTIK_CLIENT_SECRET=YOUR_AUTHENTIK_CLIENT_SECRET

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Backup settings
# This controls how often backups are made and how long they're kept
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ===========================================
# DEVELOPMENT/DEBUG SETTINGS
# ===========================================

# Debug settings (set to false in production)
# These help developers find problems, but should be off for users
DEBUG=false
VERBOSE_LOGGING=false

# ===========================================
# CUSTOM CONFIGURATION
# ===========================================

# Add any custom environment variables here
# CUSTOM_SETTING=value