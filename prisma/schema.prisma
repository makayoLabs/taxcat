// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  taxReturns    TaxReturn[]
  documents     Document[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TaxReturnStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  NETFILED
  REJECTED
}

enum FilingStatus {
  SINGLE
  MARRIED
  COMMON_LAW
  SEPARATED
  DIVORCED
  WIDOWED
}

enum DeductionCategory {
  RRSP_CONTRIBUTIONS
  MOVING_EXPENSES
  UNION_DUES
  CHILDCARE_EXPENSES
  MEDICAL_EXPENSES
  CHARITABLE_DONATIONS
  STUDENT_LOAN_INTEREST
  HOME_OFFICE
  SELF_EMPLOYMENT
  OTHER
}

enum RelationshipType {
  SPOUSE
  COMMON_LAW_PARTNER
  CHILD
  PARENT
  SIBLING
  OTHER_DEPENDENT
}

enum DocumentType {
  T4
  T4A
  T5
  T3
  T2202A
  T4E
  T4RSP
  T5007
  RRSP_RECEIPT
  CHARITABLE_RECEIPT
  MEDICAL_RECEIPT
  T2202_FOREIGN
  NR4
  T1135
  RC151
  OTHER
}

enum TaxReturnType {
  T1_GENERAL       // Personal tax return
  T2_CORPORATION   // Corporate tax return
  T3_TRUST        // Trust tax return
  T5013_PARTNERSHIP // Partnership tax return
  T4_SUMMARY      // Employer tax return
  GST_HST         // GST/HST return
  T2125_BUSINESS  // Self-employed business
  T776_RENTAL     // Rental income
  T1135_FOREIGN   // Foreign income verification
  T1_DECEASED     // Final return for deceased
  T1_BANKRUPTCY   // Bankruptcy return
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  CORPORATION
  PARTNERSHIP
  TRUST
  NON_PROFIT
  CHARITY
}

enum IndustryType {
  RETAIL
  SERVICES
  MANUFACTURING
  CONSTRUCTION
  TECHNOLOGY
  HEALTHCARE
  REAL_ESTATE
  AGRICULTURE
  HOSPITALITY
  PROFESSIONAL
  OTHER
}

model TaxReturn {
  id                String          @id @default(cuid())
  userId            String
  year              Int
  filingStatus      FilingStatus
  status            TaxReturnStatus @default(DRAFT)
  type              TaxReturnType   @default(T1_GENERAL)
  isIndigenous      Boolean         @default(false)
  indigenousNumber  String?         // Status card number
  hasEmploymentIncome Boolean       @default(false)
  hasSelfEmployment  Boolean       @default(false)
  hasInvestmentIncome Boolean      @default(false)
  hasRRSP           Boolean        @default(false)
  hasRentalIncome   Boolean        @default(false)
  hasPensions       Boolean        @default(false)
  hasForeignIncome  Boolean        @default(false)
  foreignCountries  String[]       // List of countries with foreign income
  businessInfo      BusinessInfo?  // For business returns
  estateInfo        EstateInfo?   // For trust/estate returns
  bankruptcyInfo    BankruptcyInfo? // For bankruptcy returns
  totalIncome       Float          @default(0)
  totalDeductions   Float          @default(0)
  totalTaxCredits   Float          @default(0)
  federalTax        Float          @default(0)
  provincialTax     Float          @default(0)
  foreignTaxCredits Float          @default(0)
  cppContributions  Float          @default(0)
  eiPremiums        Float          @default(0)
  refundAmount      Float          @default(0)
  balanceOwing      Float          @default(0)
  formData          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  documents         Document[]
  t4Slips           T4Slip[]
  t5Slips           T5Slip[]
  deductions        Deduction[]
  dependents        Dependent[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessInfo {
  id                String       @id @default(cuid())
  taxReturnId       String       @unique
  businessType      BusinessType
  industryType      IndustryType
  businessNumber    String      // CRA Business Number
  businessName      String
  startDate         DateTime?
  fiscalYearEnd     DateTime
  numberOfEmployees Int          @default(0)
  revenue           Float        @default(0)
  expenses          Float        @default(0)
  assets            Float        @default(0)
  liabilities       Float        @default(0)
  hasInventory      Boolean      @default(false)
  usesCashMethod    Boolean      @default(true)
  taxReturn         TaxReturn    @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model EstateInfo {
  id                String       @id @default(cuid())
  taxReturnId       String       @unique
  deceasedName      String?     // For final returns
  dateOfDeath       DateTime?   // For final returns
  trustName         String?     // For trust returns
  trustNumber       String?     // Trust account number
  trustType         String?     // Type of trust
  beneficiaries     String[]    // List of beneficiaries
  distributions     Float        @default(0)
  taxReturn         TaxReturn    @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model BankruptcyInfo {
  id                String       @id @default(cuid())
  taxReturnId       String       @unique
  dateOfBankruptcy  DateTime
  trusteeNumber     String      // Licensed Insolvency Trustee number
  trusteeName       String
  prePostFlag       String      // Pre or post-bankruptcy return
  taxReturn         TaxReturn    @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model Document {
  id          String       @id @default(cuid())
  userId      String
  taxReturnId String?
  name        String
  type        DocumentType
  url         String
  fileSize    Int
  mimeType    String
  uploadDate  DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxReturn   TaxReturn?   @relation(fields: [taxReturnId], references: [id])
}

model T4Slip {
  id                    String    @id @default(cuid())
  taxReturnId          String
  employerName         String
  employerNumber       String    // Business Number (BN)
  box14_Employment     Float     // Employment Income
  box22_CPP           Float     // CPP Contributions
  box24_EI            Float     // EI Premiums
  box16_Tax           Float     // Income Tax Deducted
  box26_CPPPensionable Float    // CPP/QPP Pensionable Earnings
  box28_EIInsurable   Float     // EI Insurable Earnings
  box10_Province      String    // Province of Employment
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  taxReturn           TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model T5Slip {
  id                  String    @id @default(cuid())
  taxReturnId        String
  payerName          String
  payerNumber        String    // Payer's Business Number
  box10_DividendAmount Float    // Actual Amount of Dividends
  box11_EligibleDividend Float // Taxable Amount of Eligible Dividends
  box13_InterestIncome Float   // Interest from Canadian Sources
  box15_ForeignIncome Float    // Foreign Income
  box17_CapitalGains  Float    // Capital Gains Dividends
  box23_Tax          Float     // Income Tax Deducted
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  taxReturn          TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model Deduction {
  id          String            @id @default(cuid())
  taxReturnId String
  category    DeductionCategory
  description String
  amount      Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  taxReturn   TaxReturn        @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
}

model Dependent {
  id          String           @id @default(cuid())
  taxReturnId String
  firstName   String
  lastName    String
  sin         String          // Social Insurance Number
  relationship RelationshipType
  dateOfBirth DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  taxReturn   TaxReturn       @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
} 